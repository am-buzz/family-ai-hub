<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.familyai.openwebui</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_DIR__/scripts/start-open-webui.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.family-ai/logs/openwebui.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.family-ai/logs/openwebui.err.log</string>
</dict>
</plist>
