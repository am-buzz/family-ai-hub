# Family AI Hub: runtime settings for Open WebUI.
# Copy to ~/.family-ai/family-ai.env and edit. That file is never committed.
# Setting names follow Open WebUI's documented environment variables; after installing
# or upgrading, check each one against the docs for the installed version.

# --- Paths (all data stays on this Mac) ---
FAMILY_AI_HOME="$HOME/.family-ai"
DATA_DIR="$HOME/.family-ai/data"          # chats, uploads, vector index, webui.db
BACKUP_DIR="$HOME/.family-ai/backups"     # point at a second volume, see the setup guide

# --- Open WebUI ---
WEBUI_NAME="Family AI Hub"
HOST="127.0.0.1"                          # loopback only; Tailscale serve fronts it
PORT="8080"
# Generated by scripts/install.sh on first run and stored in this file.
WEBUI_SECRET_KEY=""

# Accounts: closed signups. The admin creates accounts; anyone who somehow registers waits for approval.
ENABLE_SIGNUP="false"
DEFAULT_USER_ROLE="pending"

# Admin privacy: the admin does not read other people's chats (owner decision, Oct 2026).
ENABLE_ADMIN_CHAT_ACCESS="false"
ENABLE_ADMIN_EXPORT="false"

# No community sharing, no telemetry.
ENABLE_COMMUNITY_SHARING="false"
SCARF_NO_ANALYTICS="true"
DO_NOT_TRACK="true"
ANONYMIZED_TELEMETRY="false"

# --- Models ---
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Cloud providers are NOT connected in phase 1. They arrive in phase 2 behind the trust gateway.
ENABLE_OPENAI_API="false"

# Local embeddings for document retrieval (pulled by scripts/pull-models.sh).
RAG_EMBEDDING_ENGINE="ollama"
RAG_EMBEDDING_MODEL="nomic-embed-text"

# --- Tailscale ---
TAILSCALE_HTTPS_PORT="8443"
